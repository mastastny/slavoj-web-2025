package views

templ CancelReservationSuccess() {
@templ.Raw("<!DOCTYPE html>")
<html lang="cs">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no"/>
    <title>Zrušení rezervace — TJ Slavoj Loštice</title>
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet"/>
    <link rel="stylesheet" href="/assets/css/templatemo-finance-business.css"/>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg"/>
</head>
<body>
<div class="page-heading header-text">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h1>Zrušení rezervace</h1>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="bg-light p-5 rounded">
                <span style="font-size:3rem; color:#28a745;">&#10003;</span>
                <h3 class="mt-3">Rezervace byla zrušena</h3>
                <p class="text-muted mt-2">Vaše rezervace byla úspěšně zrušena.</p>
                <a href="/" class="filled-button mt-3 d-inline-block">Zpět na hlavní stránku</a>
            </div>
        </div>
    </div>
</div>
</body>
</html>
}

templ CancelReservationError() {
@templ.Raw("<!DOCTYPE html>")
<html lang="cs">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no"/>
    <title>Zrušení rezervace — TJ Slavoj Loštice</title>
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet"/>
    <link rel="stylesheet" href="/assets/css/templatemo-finance-business.css"/>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg"/>
</head>
<body>
<div class="page-heading header-text">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h1>Zrušení rezervace</h1>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="bg-light p-5 rounded">
                <span style="font-size:3rem; color:#ec543d;">&#10007;</span>
                <h3 class="mt-3">Rezervaci se nepodařilo zrušit</h3>
                <p class="text-muted mt-2">
                    Zkuste to prosím znovu později, nebo kontaktujte administrátora na
                    <a href="mailto:info@slavojlostice.cz" style="color:#ec543d;">info@slavojlostice.cz</a>.
                </p>
                <a href="/" class="filled-button mt-3 d-inline-block">Zpět na hlavní stránku</a>
            </div>
        </div>
    </div>
</div>
</body>
</html>
}
