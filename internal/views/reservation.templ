package views

import (
  "fmt"
  "github.com/mastastny/slavoj-web-2025/internal/models"
)

script callSelectCourt(id int) {
    selectCourt(id)
}


templ ReservationHead() {
 <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.19/index.global.min.js'></script>

 <script>
 window.currentCourtId = 1;
 window.currentSelection = null;

    function selectCourt(id) {
        window.currentCourtId = id;
        // Update sidebar active state
        document.querySelectorAll('.res-court-list .list-group-item').forEach(function(btn) {
            btn.classList.toggle('active', parseInt(btn.dataset.court) === id);
        });
        // Update zone highlight on areal map
        document.querySelectorAll('.areal_overlay .zone').forEach(function(zone) {
            zone.classList.toggle('zone--active', parseInt(zone.dataset.court) === id);
        });
        // Reset calendar
        var el = document.getElementById('calendar');
        if (el) el.dataset.initialized = '';
        initCalendar();
        // Clear any previous time selection
        window.currentSelection = null;
        updateBottomBar();
    }

    function updateBottomBar() {
        var btnShrnuti = document.getElementById('btn-shrnuti');
        var sel = window.currentSelection;
        btnShrnuti.disabled = !sel;
    }

    function openSummaryModal() {
        var sel = window.currentSelection;
        if (!sel) return;
        var courtBtn = document.querySelector('.res-court-list .list-group-item.active');
        var courtName = courtBtn ? courtBtn.childNodes[0].textContent.trim() : 'Hřiště ' + window.currentCourtId;
        openBookingModal({
            date:      sel.start.toISOString().slice(0, 10),
            startTime: sel.start,
            endTime:   sel.end,
            area:      courtName,
            areaId:    window.currentCourtId
        });
    }

   function initCalendar() {
     const el = document.getElementById('calendar');
     if (!el || el.dataset.initialized) return; // už inicializovaný nebo není na stránce
     window.calendar = new FullCalendar.Calendar(el, {
       initialView: window.innerWidth < 768 ? 'timeGridDay' : 'timeGridWeek',
       locale: 'cs',
      firstDay: 1,
       timeZone: 'Europe/Prague',
       slotMinTime: '08:00:00',
       slotMaxTime: '22:00:00',
       slotDuration: '00:30:00',
       selectable: true,
       selectLongPressDelay: 0,
       unselectAuto: false,
       selectMirror: true,
       contentHeight: 'auto',
       allDayText: 'celý den',
       buttonText: {
         today: 'Dnes',
         month: 'Měsíc',
         week: 'Týden',
         day: 'Den',
       },
       eventSources: [
         {
           url: '/api/events',
           extraParams: () => ({ court_id: window.currentCourtId })
         },
       ],
      selectAllow: function(info) {
        return info.start >= new Date();
      },
      dateClick: function(info) {
        // Tap na mobilu (bez dragu) — vyber 1 hodinu od tapnutého slotu
        var start = info.date;
        if (start < new Date()) return; // minulý slot — ignoruj
        var end = new Date(start.getTime() + 60 * 60 * 1000);
        window.calendar.select(start, end); // spustí select callback níže
      },
      select: function(info) {
        window.currentSelection = { start: info.start, end: info.end };
        updateBottomBar();
      },
      datesSet: function() {
        var now = new Date();
        var slotStart = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 8, 0, 0);
        var slotEnd   = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 22, 0, 0);
        var pct = Math.max(0, Math.min(100, (now - slotStart) / (slotEnd - slotStart) * 100));
        var col = document.querySelector('td.fc-timegrid-col.fc-day-today');
        if (!col) return;
        if (pct <= 0) {
          col.style.background = 'rgba(255, 200, 0, 0.25)';
        } else if (pct >= 100) {
          col.style.background = 'rgba(44, 62, 80, 0.65)';
        } else {
          col.style.background = 'linear-gradient(to bottom, rgba(44, 62, 80, 0.65) ' + pct + '%, rgba(255, 200, 0, 0.25) ' + pct + '%)';
        }
      }
    });

     window.calendar.render();
     el.dataset.initialized = "true"; // označ element, aby se znovu nespustil

     // Ctrl+↓ — prodlouž výběr o 1 slot (30 min)
     if (!window._calKeyAttached) {
       window._calKeyAttached = true;
       document.addEventListener('keydown', function(e) {
         if (!e.ctrlKey || (e.key !== 'ArrowDown' && e.key !== 'ArrowUp')) return;
         if (!window.currentSelection || !window.calendar) return;
         e.preventDefault();
         var slot = 30 * 60 * 1000;
         var sel = window.currentSelection;
         if (e.key === 'ArrowDown') {
           var newEnd = new Date(sel.end.getTime() + slot);
           // Nepřekračuj slotMaxTime (22:00)
           var maxTime = new Date(sel.end);
           maxTime.setHours(22, 0, 0, 0);
           if (newEnd > maxTime) return;
           window.calendar.select(sel.start, newEnd);
         } else {
           var newEnd = new Date(sel.end.getTime() - slot);
           // Minimálně 1 slot (30 min)
           if (newEnd <= sel.start) return;
           window.calendar.select(sel.start, newEnd);
         }
       });
     }

     // Reaguj na změnu velikosti okna / zoom
     if (!window._calResizeAttached) {
       window._calResizeAttached = true;
       window.addEventListener('resize', function() {
         clearTimeout(window._calResizeTimer);
         window._calResizeTimer = setTimeout(function() {
           if (!window.calendar) return;
           // Přepočítá souřadnice buněk (opravuje touch po zoomu)
           window.calendar.updateSize();
           // Přepni view podle aktuální šířky
           var isMobile = window.innerWidth < 768;
           var target = isMobile ? 'timeGridDay' : 'timeGridWeek';
           if (window.calendar.view.type !== target) {
             window.calendar.changeView(target);
           }
         }, 200);
       });
     }
   }

   // inicializace při prvním načtení
   document.addEventListener('DOMContentLoaded', initCalendar);

   // inicializace při každém HTMX swapu do #centre-page
   document.body.addEventListener('htmx:afterSwap', function (evt) {
     if (evt.target.id === "centre-page") {
       initCalendar();
     }
   });
 </script>

 <link rel="stylesheet" href="css/reservation.css">

}


templ Reservation(courts []models.Court) {
  @Modal()

<div class="page-heading header-text">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h1>Rezervace</h1>
                <span>Vyberte si hřiště, zvolte volný čas a rezervujte si hřiště. </span>
            </div>
        </div>
    </div>
</div>

<div class="res-city-banner">
    <div class="container">
        <a href="https://www.mu-lostice.cz" target="_blank" rel="noopener noreferrer">
            <img src="/images/sponsors/logo_lostice.jpg" alt="Město Loštice"/>
        </a>
    </div>
</div>

  <div class="res-page">

    <!-- Main content constrained to container width -->
    <div class="container">

      <!-- Top bar -->
      <div class="row">
        <div class="col-md-12">
          <div class="res-topbar d-flex align-items-center py-2">
            <span class="font-weight-bold">Zvolte hřiště</span>
          </div>
        </div>
      </div>

      <!-- Row 1: interaktivní mapa areálu -->
      <div class="row">
        <div class="col-md-12 text-center py-3 border-bottom">
          <div class="areal mx-auto">
            <img src="/images/areal.png" alt="Sportoviště" class="areal_img">
            <div class="areal_overlay">
                <button class="zone zone--rect hriste-1 zone--active" data-court="2" aria-label="Hřiště 1" hx-on:click="selectCourt(2)"><span>tenisový kurt 1</span></button>
                <button class="zone zone--rect hriste-2" data-court="3" aria-label="Hřiště 2" hx-on:click="selectCourt(3)"><span>tenisový kurt 2</span></button>
                <button class="zone zone--poly hriste-3" data-court="6" aria-label="Hřiště 3" hx-on:click="selectCourt(6)"><span>travnaté hřiště</span></button>
                <!--              for i, court := range courts {-->
<!--                <button-->
<!--                  class={ "zone", templ.KV("zone&#45;&#45;rect", i < 2), templ.KV("zone&#45;&#45;poly", i >= 2), templ.KV("zone&#45;&#45;active", i == 0), "hriste-" + fmt.Sprint(court.ID) }-->
<!--                  data-court={ fmt.Sprint(court.ID) }-->
<!--                  aria-label={ court.Name }-->
<!--                  onclick={ callSelectCourt(court.ID) }>-->
<!--                  { court.Name }-->
<!--                </button>-->
<!--              }-->
            </div>
          </div>
        </div>
      </div>

      <!-- Row 2: sidebar (seznam hřišť) + kalendář -->
      <div class="row">
        <div class="col-md-12">
          <div class="res-topbar d-flex align-items-center py-2 border-bottom">
            <span class="font-weight-bold">Vyberte termín</span>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-12 px-0">
          <div class="res-body">

            <div class="res-sidebar">
              <div class="list-group list-group-flush res-court-list">
                for i, court := range courts {
                  <button
                    type="button"
                    class={ "list-group-item", "list-group-item-action", templ.KV("active", i == 0) }
                    data-court={ fmt.Sprint(court.ID) }
                    onclick={ callSelectCourt(court.ID) }>
                    { court.Name }
                    <i class="fa fa-info-circle ml-auto text-muted" title="Info"></i>
                  </button>
                }
              </div>
            </div>

            <div class="res-calendar-panel p-3">
              <p class="text-muted small text-uppercase mb-2">Datum a čas</p>
              <div id="calendar"></div>
            </div>

          </div>
        </div>
      </div>

    </div><!-- /container -->

    <!-- Bottom bar -->
    <div class="container">
      <div class="row">
        <div class="col-md-12">
          <div class="res-bottombar d-flex align-items-center justify-content-between py-2 border-top">
            <span class="font-weight-bold">Vytvořte rezervaci</span>
            <button type="button" class="filled-button" id="btn-shrnuti"
              disabled onclick="openSummaryModal()">
              Vytvoření rezervace
            </button>
          </div>
        </div>
      </div>
    </div>

  </div><!-- /res-page -->
}


templ Form() {

