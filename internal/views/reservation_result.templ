package views

import (
	"fmt"
	"time"

	"github.com/mastastny/slavoj-web-2025/internal/models/reservation"
)

func formatReservationDate(iso string) string {
	t, err := time.Parse(time.RFC3339, iso)
	if err != nil {
		return iso
	}
	return t.Local().Format("02.01.2006")
}

func formatReservationTime(iso string) string {
	t, err := time.Parse(time.RFC3339, iso)
	if err != nil {
		return iso
	}
	return t.Local().Format("15:04")
}


templ ReservationError(msg string) {
	<div class="modal-header">
		<h5 class="modal-title">Chyba rezervace</h5>
		<button type="button" class="close" data-dismiss="modal" aria-label="Zavřít">
			<span aria-hidden="true">&times;</span>
		</button>
	</div>
	<div class="modal-body">
		<p class="text-center mb-0">{ msg }</p>
	</div>
	<div class="modal-footer justify-content-center">
		<button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Zavřít</button>
	</div>
}

templ ReservationResult(r reservation.Handler, courtName string) {
	<div class="modal-header">
		<h5 class="modal-title">Rezervace potvrzena</h5>
		<button type="button" class="close" data-dismiss="modal" aria-label="Zavřít">
			<span aria-hidden="true">&times;</span>
		</button>
	</div>
	<div class="modal-body">
		<div class="text-center mb-3">
			<span style="font-size: 2.5rem;">&#10003;</span>
			<h5 class="mt-2">Rezervace úspěšně vytvořena</h5>
		</div>
		<div class="bg-light p-3 rounded mb-3">
			<div class="d-flex justify-content-between mb-2">
				<div>
					<div class="small text-muted">Datum</div>
					<div class="font-weight-bold">{ formatReservationDate(r.Start) }</div>
				</div>
				<div>
					<div class="small text-muted">Od</div>
					<div class="font-weight-bold">{ formatReservationTime(r.Start) }</div>
				</div>
				<div>
					<div class="small text-muted">Do</div>
					<div class="font-weight-bold">{ formatReservationTime(r.End) }</div>
				</div>
				<div>
					<div class="small text-muted">Hráči</div>
					<div class="font-weight-bold">{ fmt.Sprintf("%d", r.PlayerCount) }</div>
				</div>
			</div>
			<div>
				<div class="small text-muted">Hřiště</div>
				<div class="font-weight-bold">{ courtName }</div>
			</div>
		</div>
		<p class="text-muted text-center small mb-0">
			E-mail s potvrzením rezervace vám dojde během chvíle na adresu <strong>{ r.Email }</strong>.
		</p>
	</div>
	<div class="modal-footer justify-content-center">
		<button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Zavřít</button>
	</div>
}
